# ==============================================================================
# NyayaMitra — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values.
# NEVER COMMIT .env TO SOURCE CONTROL.
# ==============================================================================

# ── Application & Runtime ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secure-random-32-byte-hex-string

# ── Security & CORS ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
ENABLE_PII_REDACTION=true

# ── Database (Supabase PostgreSQL — recommended for production) ────────────────
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string (Session mode)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/postgres

# Set to false in production so the Supabase URL above is used.
# Set to true only for quick local testing with SQLite.
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./nyayamitra.db

# ── Cache & Rate Limiter (Upstash Redis — recommended for production) ──────────
# Get this from: Upstash Console → Database → Connect → Node.js → REDIS_URL
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
CACHE_TTL_SECONDS=3600

# ── AI / LLM Routing ──────────────────────────────────────────────────────────
# Primary: Gemini. Fallback: Groq (auto-triggered on quota exhaustion).
LLM_PROVIDER=gemini
PRIMARY_MODEL=gemini-2.0-flash
FALLBACK_MODEL=llama3-70b-8192
FAST_MODEL=gemini-2.0-flash-lite

# ── API Keys ──────────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# ── Embeddings ────────────────────────────────────────────────────────────────
# Supported: "mock", "fastembed", "huggingface"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ── Document Storage & OCR ────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
FILE_RETENTION_HOURS=24
# Supported OCR providers: "mock", "tesseract", "google_vision"
OCR_PROVIDER=mock

# ── External Legal Source Adapters ────────────────────────────────────────────
INDIA_CODE_BASE_URL=https://www.indiacode.nic.in
ECOURTS_PORTAL_URL=https://services.ecourts.gov.in
NALSA_PORTAL_URL=https://nalsa.gov.in
TELE_LAW_URL=https://www.tele-law.in

# ── Frontend Public Variables (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NyayaMitra
NEXT_PUBLIC_APP_VERSION=1.0.0
