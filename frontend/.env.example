# =================================================================
# NyayaMitra Frontend Environment Configuration Contract
# =================================================================

# Production FastAPI backend endpoint (e.g. Render/Railway/Custom)
# In production, this variable is REQUIRED. In development, defaults to http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=https://nyaya-mitra-api.onrender.com/api/v1

# Voice Speech-to-Text Feature Gate (true / false)
# Set to 'false' by default; keeps microphone button accessibly disabled or gated until STT worker is provisioned.
NEXT_PUBLIC_ENABLE_STT=false
